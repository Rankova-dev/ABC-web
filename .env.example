# ============================================================
# ABC Centre — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales
# ============================================================

# ----------------------------------------------------------
# Google Calendar API (Service Account)
# Docs: https://developers.google.com/calendar/api/guides/auth
# ----------------------------------------------------------

# Email de la Service Account (formato: nombre@proyecto.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Clave privada de la Service Account (incluyendo -----BEGIN/END PRIVATE KEY-----)
# En .env.local escríbela en una sola línea con \n para los saltos de línea
GOOGLE_PRIVATE_KEY=

# IDs de los calendarios de Google Calendar por especialidad
# Se obtienen en Google Calendar > Configuración del calendario > ID del calendario
GOOGLE_CALENDAR_ID_LOGOPEDIA=
GOOGLE_CALENDAR_ID_PSICOLOGIA=
GOOGLE_CALENDAR_ID_NEUROPSICOLOGIA=
GOOGLE_CALENDAR_ID_PSICOPEDAGOGIA=
GOOGLE_CALENDAR_ID_TEA=
GOOGLE_CALENDAR_ID_VOZ=
GOOGLE_CALENDAR_ID_FAMILIAR=
GOOGLE_CALENDAR_ID_GENERAL=

# ----------------------------------------------------------
# Email transaccional (confirmación de cita + newsletter)
#
# El código elige el primer backend configurado:
#
#   1) SMTP  →  SMTP_HOST + SMTP_USER + SMTP_PASS
#      RECOMENDADO para abccentre.es: el correo del dominio está en IONOS
#      (MX mx00/mx01.ionos.es), no en Google Workspace, así que la delegación
#      de dominio de Gmail API no es posible en este dominio.
#      IONOS → host smtp.ionos.es, puerto 587 (STARTTLS),
#      usuario = el email completo del buzón, contraseña = la del buzón.
#
#   2) Gmail API →  GOOGLE_SERVICE_ACCOUNT_EMAIL + GOOGLE_PRIVATE_KEY +
#      GMAIL_SENDER_EMAIL. Solo funciona con Google Workspace + domain-wide
#      delegation en el dominio remitente.
#      Docs: https://developers.google.com/workspace/guides/create-credentials
#
#   3) Nada configurado → los emails se loguean en consola, no se envían.
# ----------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remitente. Por defecto: SMTP_USER, o GMAIL_SENDER_EMAIL, o noreply@abccentre.es
MAIL_FROM=info@abccentre.es

# Solo para el backend Gmail API: dirección suplantada por la service account
GMAIL_SENDER_EMAIL=info@abccentre.es

# Buzón interno: recibe el aviso de cada cita nueva y las respuestas de las
# pacientes (Reply-To). Puede ser de CUALQUIER dominio, incluido un Gmail.
# ⚠️ citas@abccentre.es nos lo inventamos nosotros: no aparece en la web del
#    centro. Confirmar que existe antes de usarlo, o poner info@abccentre.es.
MAIL_INTERNAL_RECIPIENT=info@abccentre.es

# ----------------------------------------------------------
# Newsletter (formulario de suscripción de la home)
# Opcional: si se deja vacío, los suscriptores solo quedan en los logs
# y no se guardan en ningún sitio — el email de bienvenida sí se envía
# igualmente si GMAIL_SENDER_EMAIL está configurado.
# ----------------------------------------------------------

# ID de la Google Sheet donde se guardan los suscriptores (con una pestaña
# llamada "Suscriptores" y compartida como Editor con la Service Account)
GOOGLE_SHEETS_NEWSLETTER_ID=

# Código de descuento que se envía en el email de bienvenida
NEWSLETTER_DISCOUNT_CODE=BIENVENIDA10

# ----------------------------------------------------------
# Google Places API (New) — carrusel de reseñas de Google
# 1. En Google Cloud Console, habilita "Places API (New)"
# 2. Crea una API key y restríngela a esa API (y opcionalmente por IP/referrer)
# 3. Busca el Place ID del negocio: https://developers.google.com/maps/documentation/places/web-service/place-id
# Si se dejan vacías, el carrusel de reseñas simplemente no se muestra (no hay datos de ejemplo).
# ----------------------------------------------------------
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ----------------------------------------------------------
# URL del sitio (sin trailing slash)
# ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://abccentre.es
# ── Resend (RECOMENDADO en producción) ────────────────────────────────────────
# Va por HTTPS (443), así que NO le afecta el bloqueo de puertos SMTP salientes
# (25/465/587) que Hetzner aplica por defecto. Si está definida, tiene prioridad
# sobre SMTP y sobre Gmail API.
#   1. resend.com → Domains → añadir abccentre.es → copiar los registros DNS
#   2. Pegar esos registros en IONOS → Dominios → abccentre.es → DNS
#   3. API Keys → Create → pegar aquí la clave (empieza por re_)
RESEND_API_KEY=

